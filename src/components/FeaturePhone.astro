---
import Image from "astro/components/Image.astro";
import Logo from "../../public/logo_transparent_540.png";
import VoiceNoteBubble from "./VoiceNoteBubble.astro";
import TextBubble from "./TextBubble.astro";
import Icon from "./Icon.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="mockup-phone border-accent">
  <div class="camera"></div>
  <div class="display">
    <div class="artboard artboard-demo phone-1 h-auto min-h-[568px] pb-8">
      <div class="flex-col h-full w-full">
        <div class="navbar bg-primary text-primary-content mb-4 pt-6 w-full">
          <div class="flex-none">
            <div class="h-10 w-10 overflow-hidden rounded-full bg-secondary">
              <Image src={Logo} alt="" loading="eager" />
            </div>
          </div>
          <div class="flex-1 min-w-0 mx-2">
            <span class="block text-xl font-medium leading-tight">{t("thread.botName")}</span>
            <span class="block text-xs opacity-80">{t("thread.example")}</span>
          </div>
          <div class="flex-none">
            <span class="btn btn-circle btn-ghost pointer-events-none" aria-hidden="true">
              <Icon name="dots-vertical" class="h-6 w-6" />
            </span>
          </div>
        </div>
        <div class="px-5">
          <div id="voicenote-bubble" data-reveal="pop" style="--reveal-delay: 0.75s">
            <VoiceNoteBubble />
          </div>
          <div id="text-bubble" class="mt-4" data-reveal="pop" style="--reveal-delay: 1.5s">
            <TextBubble quota short />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
