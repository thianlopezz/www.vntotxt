---
/**
 * The home page for both locales. `src/pages/index.astro` and
 * `src/pages/es/index.astro` render this; the locale comes from the URL.
 */
import { Image } from "astro:assets";
import VoiceChatPana from "../../public/voice-chat-pana.svg";
import DescriptionDisplay from "./DescriptionDisplay.astro";
import NavigationLayout from "../layouts/NavigationLayout.astro";
import SubscriptionCardList from "./SubscriptionCardList.astro";
import StepsThread from "./StepsThread.astro";
import FeaturePhone from "./FeaturePhone.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  language: "en" | "es";
}

const { language } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const BOT_LINK = "https://api.whatsapp.com/send?phone=17867444726";
---

<NavigationLayout language={language}>
  <main class="md:flex md:items-center md:min-h-screen mx-auto bg-secondary lg:px-36">
    <div
      id="hero-section"
      class="w-full md:w-1/2 p-10 flex flex-col justify-center"
    >
      <h1
        class="text-5xl sm:text-6xl mb-4 text-center md:text-left font-ubuntu font-bold text-balance"
      >
        {t("home.mainTitle.1")}
        <br />
        <span class="text-primary md:text-7xl">{t("home.mainTitle.2")}</span>
        <br />
        {t("home.mainTitle.3")} <span aria-hidden="true">🔈</span>
      </h1>
      <p class="my-5 text-center md:text-left text-xl text-gray-800 max-w-prose">
        {t("home.mainDescription")}
      </p>
      <div class="flex flex-col items-center gap-2 pt-3 md:items-start md:pt-0">
        <a
          class="btn btn-primary btn-wide"
          href={BOT_LINK}
          target="_blank"
          rel="noopener"
          >{t("home.mainCallToAction")} <span class="text-xl" aria-hidden="true">😎</span></a
        >
        <span class="text-sm text-gray-600">{t("global.opensWhatsApp")}</span>
      </div>
    </div>
    <div id="phone-section" class="flex items-center justify-center py-10 md:w-1/2">
      <FeaturePhone />
    </div>
  </main>

  <section id="how-it-works" class="container mx-auto px-5 py-16 md:px-10">
    <h2
      id="how-it-works-title"
      class="text-4xl text-center mb-10 font-ubuntu font-bold"
    >
      {t("home.howItWorks.title")}
    </h2>
    <StepsThread />
  </section>

  <section id="features" class="bg-secondary py-16">
    <div class="container mx-auto px-5 md:px-10">
      <h2
        id="features-title"
        class="text-4xl text-center font-ubuntu font-bold text-balance"
      >
        {t("home.features.title.1")}
        {" "}<span class="text-primary">{t("home.features.title.2")}</span>
        {t("home.features.title.3") && (
          <>
            {" "}{t("home.features.title.3")}
          </>
        )} <span aria-hidden="true">📝</span>
      </h2>
      <div id="features-body" class="mt-10 flex flex-col-reverse gap-10 md:flex-row md:items-center">
        <div class="w-full md:w-5/12">
          <Image
            src={VoiceChatPana}
            alt={t("home.features.imageAlt")}
            loading="lazy"
            class="mx-auto w-full max-w-md"
          />
        </div>
        <div class="w-full md:w-7/12">
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
            <DescriptionDisplay
              icon="world"
              title={t("home.features.item.1.title")}
              description={t("home.features.item.1.description")}
            />
            <DescriptionDisplay
              icon="face"
              title={t("home.features.item.2.title")}
              description={t("home.features.item.2.description")}
            />
            <DescriptionDisplay
              icon="search"
              title={t("home.features.item.3.title")}
              description={t("home.features.item.3.description")}
            />
            <DescriptionDisplay
              icon="user-voice"
              title={t("home.features.item.4.title")}
              description={t("home.features.item.4.description")}
            />
          </div>
          <div id="features-call-to-action" class="mt-10 flex flex-col items-center gap-2 sm:items-start">
            <a
              class="btn btn-primary"
              href={BOT_LINK}
              target="_blank"
              rel="noopener"
              >{t("home.features.callToAction")} <span class="text-xl" aria-hidden="true">😎</span></a
            >
            <span class="text-sm text-gray-600">{t("global.opensWhatsApp")}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="container mx-auto px-5 py-16 md:px-10">
    <h2 id="pricing-title" class="text-4xl text-center font-ubuntu font-bold">
      {t("home.pricing.title")}
    </h2>
    <p class="mx-auto mt-4 mb-10 max-w-xl text-center text-lg text-gray-800">
      {t("home.pricing.intro")}
    </p>
    <div id="pricing-body" class="mx-auto max-w-4xl">
      <SubscriptionCardList />
    </div>
  </section>
</NavigationLayout>

<script is:inline>
  // Smooth-scroll the in-page nav links.
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      const target = document.querySelector(this.getAttribute("href"));
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: "smooth" });
      // Close the mobile dropdown after choosing.
      if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
    });
  });

  // One authored entrance: chat bubbles pop in when they scroll into view.
  // Content is visible without JS; html.js + [data-reveal] hides it until then.
  const revealables = document.querySelectorAll("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );
    revealables.forEach((el) => observer.observe(el));
  } else {
    revealables.forEach((el) => el.classList.add("is-visible"));
  }
</script>
