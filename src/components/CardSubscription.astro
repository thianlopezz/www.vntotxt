---
/**
 * Plan summary card used on the checkout pages (/vntotxt-free, /vntotxt-pro).
 * The home page uses PlanCard instead.
 */
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Feature {
  description: string;
  included: boolean;
}

interface Props {
  title: string;
  price?: string;
  checkoutLink?: string;
  comingText?: string;
  subscribeText?: string;
  subscribeButtonId?: string;
  features: Feature[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  price,
  features,
  checkoutLink,
  comingText = t("plan.premium.comingSoon"),
  subscribeText = t("plan.pro.cta"),
  subscribeButtonId,
} = Astro.props;
---

<div class="card w-full max-w-sm bg-base-100 shadow-lg h-full">
  <div class="card-body">
    <h3 class="card-title text-4xl font-bold mb-1">{title}</h3>
    {
      price ? (
        <p class="text-4xl font-bold mb-1">
          ${price}
          <small class="text-lg">{t("plan.perMonth")}</small>
        </p>
      ) : (
        <p class="text-2xl font-bold mb-1 text-gray-600">{comingText}</p>
      )
    }
    <ul class="my-2 space-y-2">
      {
        features.map((item) => (
          <li class={`flex items-start gap-2 ${item.included ? "" : "text-gray-600"}`}>
            <Icon
              name={item.included ? "check-circle" : "x"}
              class={`mt-0.5 h-5 w-5 shrink-0 ${item.included ? "text-primary" : ""}`}
            />
            <span set:html={item.description} />
          </li>
        ))
      }
    </ul>
    {
      checkoutLink && (
        <div class="card-actions justify-center">
          <a id={subscribeButtonId} class="btn btn-primary btn-block" href={checkoutLink}>
            {subscribeText}
          </a>
        </div>
      )
    }
  </div>
</div>
