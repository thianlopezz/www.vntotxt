---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Waveform bars: [x, y, height]. Played bars sit before the playhead at x=66.
const bars: [number, number, number][] = [
  [0, 17, 6], [7, 15.5, 9], [14, 6.5, 27], [21, 6.5, 27], [28, 3, 34],
  [35, 3, 34], [42, 5.5, 29], [49, 10, 20], [56, 13.5, 13], [63, 16, 8],
  [70, 12.5, 15], [77, 3, 34], [84, 3, 34], [91, 0.5, 39], [98, 0.5, 39],
  [105, 2, 36], [112, 6.5, 27], [119, 9, 22], [126, 11.5, 17], [133, 2, 36],
  [140, 2, 36], [147, 7, 26], [154, 9, 22], [161, 9, 22], [168, 13.5, 13],
  [175, 16, 8], [182, 17.5, 5],
];
---

<div class={`flex justify-end ${className}`}>
  <div
    class="flex flex-col gap-2 w-11/12 p-4 bg-lime-100 rounded-tl-xl rounded-br-xl rounded-bl-xl"
  >
    <div class="flex items-center gap-2 text-sm text-gray-600">
      <Icon name="share" class="h-4 w-4 -scale-x-100" />
      <span>{t("thread.forwarded")}</span>
    </div>
    <div class="flex items-center gap-2" role="img" aria-label={t("thread.voiceNote")}>
      <div
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-orange-500 text-white"
      >
        <Icon name="microphone" class="h-6 w-6" />
      </div>
      <Icon name="play" class="h-9 w-9 shrink-0 text-slate-600" />
      <div class="min-w-0 flex-1">
        <svg
          aria-hidden="true"
          class="w-full h-10"
          viewBox="0 0 185 40"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="none"
        >
          {
            bars.map(([x, y, h]) => (
              <rect
                x={x}
                y={y}
                width="3"
                height={h}
                rx="1.5"
                fill={x < 66 ? "#9fa1ab" : "#e5e7eb"}
              />
            ))
          }
          <rect x="66" y="16" width="8" height="8" rx="4" fill="#1c64f2"></rect>
        </svg>
        <div class="flex justify-between text-xs text-gray-600">
          <span>0:42</span>
          <span>{t("thread.time")}</span>
        </div>
      </div>
    </div>
  </div>
</div>
