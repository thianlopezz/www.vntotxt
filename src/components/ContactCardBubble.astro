---
import Image from "astro/components/Image.astro";
import Logo from "../../public/logo_transparent_540.png";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const BOT_LINK = "https://api.whatsapp.com/send?phone=17867444726";
---

<div class={`flex justify-start ${className}`}>
  <div class="flex w-11/12 flex-col bg-lime-50 rounded-e-xl rounded-es-xl overflow-hidden">
    <div class="flex items-center gap-3 p-4">
      <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full bg-secondary">
        <Image src={Logo} alt="" class="h-12 w-12" loading="lazy" />
      </div>
      <div class="min-w-0">
        <p class="font-semibold leading-tight">{t("thread.botName")}</p>
        <p class="text-sm text-gray-600">{t("thread.contact.number")}</p>
      </div>
    </div>
    <div class="grid grid-cols-2 divide-x divide-lime-200 border-t border-lime-200">
      <a
        href="/vntotxt-bot.vcf"
        download="vntotxt-bot.vcf"
        class="flex min-h-12 items-center justify-center gap-2 px-2 text-sm font-semibold text-primary hover:bg-lime-100"
      >
        <Icon name="user-plus" class="h-5 w-5" />
        <span>{t("thread.contact.addToContacts")}</span>
      </a>
      <a
        href={BOT_LINK}
        target="_blank"
        rel="noopener"
        class="flex min-h-12 items-center justify-center gap-2 px-2 text-sm font-semibold text-primary hover:bg-lime-100"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        <span>{t("thread.contact.openChat")}</span>
      </a>
    </div>
  </div>
</div>
